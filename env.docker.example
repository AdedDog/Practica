# Скопируйте в backend/.env перед docker compose up:
#   cp env.docker.example backend/.env
#
# Порт HTML на хосте — положите в .env в корне репозитория (рядом с docker-compose.yml)
# На VDS за nginx: только localhost. Для доступа снаружи: HTTP_PORT=8789
HTTP_PORT=127.0.0.1:8789

# --- backend/.env (обязательно на проде) ---

SECRET_KEY=замените-на-длинную-случайную-строку

# OTP: на сервере обычно false + SMTP
DEV_LOG_OTP=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FALLBACK_CONSOLE=true

ADMIN_EMAIL=your.name@gmail.com
ADMIN_PASSWORD=смените-пароль-админа

# Если фронт открывают не через nginx (отдельный домен/порт)
# CORS_ORIGINS=https://your-domain.com
